<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="AdminSystemReport" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30"
    rightMargin="30" topMargin="30" bottomMargin="30">
    <!-- Unicode/PDF font fix for Vietnamese text -->
    <property name="net.sf.jasperreports.default.font.name" value="Arial" />
    <property name="net.sf.jasperreports.default.pdf.font.name" value="C:/Windows/Fonts/arial.ttf" />
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Identity-H" />
    <property name="net.sf.jasperreports.default.pdf.embedded" value="true" />
    <property name="net.sf.jasperreports.export.pdf.force.linebreak.policy" value="true" />

    <style name="BaseStyle"
        isDefault="true"
        fontName="Arial"
        pdfFontName="C:/Windows/Fonts/arial.ttf"
        pdfEncoding="Identity-H"
        isPdfEmbedded="true" />


    <parameter name="P_REPORT_TITLE" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["BÁO CÁO QUẢN LÝ HỆ THỐNG"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_REPORT_SUBTITLE" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["Tổng hợp chi nhánh, doanh thu, tồn kho, nhân viên và cảnh báo vận hành"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_TOTAL_STORES" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["0"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_ACTIVE_STORES" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["0"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_TODAY_REVENUE" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["0 đ"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_MONTH_REVENUE" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["0 đ"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_TOTAL_ORDERS" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["0"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_LOW_STOCK" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["0"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_ONLINE_SESSIONS" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["0"]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_REVENUE_ORDER_CHART" class="java.awt.Image">
        <defaultValueExpression>
            <![CDATA[null]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_FINAL_REVENUE_CHART" class="java.awt.Image">
        <defaultValueExpression>
            <![CDATA[null]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_PRODUCT_BUBBLE_CHART" class="java.awt.Image">
        <defaultValueExpression>
            <![CDATA[null]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_PRODUCT_PIE_3D_CHART" class="java.awt.Image">
        <defaultValueExpression>
            <![CDATA[null]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_REVENUE_ORDER_DIFFERENCE_CHART" class="java.awt.Image">
        <defaultValueExpression>
            <![CDATA[null]]>
        </defaultValueExpression>
    </parameter>
    <parameter name="P_FILTER_LABEL" class="java.lang.String">
        <defaultValueExpression>
            <![CDATA["Kỳ đang lọc"]]>
        </defaultValueExpression>
    </parameter>

    <parameter name="P_FILTER_FROM" class="java.sql.Timestamp">
        <defaultValueExpression>
            <![CDATA[new java.sql.Timestamp(System.currentTimeMillis())]]>
        </defaultValueExpression>
    </parameter>

    <parameter name="P_FILTER_TO" class="java.sql.Timestamp">
        <defaultValueExpression>
            <![CDATA[new java.sql.Timestamp(System.currentTimeMillis())]]>
        </defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
            SELECT section_no, section_name, col1, col2, col3, col4, col5
            FROM (
                SELECT 1 AS section_no,
                       CAST('HIEU_QUA_NHAP_BAN_THEO_CHI_NHANH' AS VARCHAR2(100)) AS section_name,
                       CAST(s.store_id AS VARCHAR2(80)) AS col1,
                       CAST(NVL(TO_CHAR(s.store_name), TO_CHAR(s.address)) AS VARCHAR2(180)) AS col2,
                       CAST(TO_CHAR(NVL(sales.total_revenue, 0), 'FM999G999G999G999') || ' VND' AS VARCHAR2(120)) AS col3,
                       CAST(TO_CHAR(NVL(imports.total_import_cost, 0), 'FM999G999G999G999') || ' VND' AS VARCHAR2(120)) AS col4,
                       CAST(TO_CHAR(NVL(sales.total_revenue, 0) - NVL(imports.total_import_cost, 0), 'FM999G999G999G999') || ' VND' AS VARCHAR2(120)) AS col5,
                       NVL(sales.total_revenue, 0) AS sort_value
                FROM stores s
                LEFT JOIN (
                    SELECT store_id, SUM(total_amount) AS total_revenue
                    FROM orders
                    WHERE NVL(is_deleted, 0) = 0
                      AND order_date >= $P{P_FILTER_FROM}
                      AND order_date < $P{P_FILTER_TO}
                      AND (
                           UPPER(NVL(status, '')) = 'COMPLETED'
                           OR UPPER(NVL(status, '')) LIKE '%HOÀN THÀNH%'
                           OR UPPER(NVL(status, '')) LIKE '%HOAN THANH%'
                      )
                    GROUP BY store_id
                ) sales ON sales.store_id = s.store_id
                LEFT JOIN (
                    SELECT store_id, SUM(total_after_tax) AS total_import_cost
                    FROM purchase_receipts
                    WHERE NVL(is_deleted, 0) = 0
                      AND created_at >= $P{P_FILTER_FROM}
                      AND created_at < $P{P_FILTER_TO}
                    GROUP BY store_id
                ) imports ON imports.store_id = s.store_id
                WHERE NVL(s.is_deleted, 0) = 0

                UNION ALL

                SELECT 2 AS section_no,
                       CAST('TON_KHO_THEO_CHI_NHANH' AS VARCHAR2(100)) AS section_name,
                       CAST(s.store_id AS VARCHAR2(80)) AS col1,
                       CAST(NVL(TO_CHAR(s.store_name), TO_CHAR(s.address)) AS VARCHAR2(180)) AS col2,
                       CAST(TO_CHAR(COUNT(DISTINCT i.product_id)) AS VARCHAR2(80)) AS col3,
                       CAST(TO_CHAR(NVL(SUM(NVL(i.quantity, 0)), 0)) AS VARCHAR2(80)) AS col4,
                       CAST(TO_CHAR(SUM(CASE WHEN NVL(i.quantity, 0) <= 20 THEN 1 ELSE 0 END)) AS VARCHAR2(80)) AS col5,
                       NVL(SUM(NVL(i.quantity, 0)), 0) AS sort_value
                FROM stores s
                LEFT JOIN inventory i ON i.store_id = s.store_id AND NVL(i.is_deleted, 0) = 0
                WHERE NVL(s.is_deleted, 0) = 0
                GROUP BY s.store_id, NVL(TO_CHAR(s.store_name), TO_CHAR(s.address))

                UNION ALL

                SELECT 3 AS section_no,
                       CAST('NHAN_VIEN_CO_DOANH_THU_CAO_NHAT' AS VARCHAR2(100)) AS section_name,
                       CAST(store_name AS VARCHAR2(180)) AS col1,
                       CAST(employee_id AS VARCHAR2(80)) AS col2,
                       CAST(employee_name AS VARCHAR2(180)) AS col3,
                       CAST(TO_CHAR(total_orders) AS VARCHAR2(80)) AS col4,
                       CAST(TO_CHAR(revenue, 'FM999G999G999G999') || ' VND' AS VARCHAR2(100)) AS col5,
                       revenue AS sort_value
                FROM (
                    SELECT NVL(TO_CHAR(s.store_name), e.store_id) AS store_name,
                           e.employee_id,
                           TO_CHAR(e.employee_name) AS employee_name,
                           COUNT(o.order_id) AS total_orders,
                           NVL(SUM(o.total_amount), 0) AS revenue
                    FROM employees e
                    LEFT JOIN stores s ON s.store_id = e.store_id
                    LEFT JOIN orders o
                        ON o.employee_id = e.employee_id
                       AND o.store_id = e.store_id
                       AND NVL(o.is_deleted, 0) = 0
                       AND o.order_date >= $P{P_FILTER_FROM}
                       AND o.order_date < $P{P_FILTER_TO}
                       AND (
                            UPPER(NVL(o.status, '')) = 'COMPLETED'
                            OR UPPER(NVL(o.status, '')) LIKE '%HOÀN THÀNH%'
                            OR UPPER(NVL(o.status, '')) LIKE '%HOAN THANH%'
                       )
                    WHERE NVL(e.is_deleted, 0) = 0
                      AND e.role_id IN ('R_STAFF_SALE', 'R_STAFF_VIEW_PROD')
                    GROUP BY NVL(TO_CHAR(s.store_name), e.store_id), e.employee_id, e.employee_name
                    ORDER BY revenue DESC, total_orders DESC
                )
                WHERE ROWNUM <= 10

                UNION ALL SELECT 89, CAST('CHART_FINAL_REVENUE' AS VARCHAR2(100)), '', '', '', '', '', 0 FROM dual
                UNION ALL SELECT 90, CAST('CHART_PAGE_1' AS VARCHAR2(100)), '', '', '', '', '', 0 FROM dual
                UNION ALL SELECT 91, CAST('CHART_PAGE_2' AS VARCHAR2(100)), '', '', '', '', '', 0 FROM dual
            )
            ORDER BY section_no, sort_value DESC, col1, col2
        ]]>
    </queryString>

    <field name="SECTION_NO" class="java.math.BigDecimal" />
    <field name="SECTION_NAME" class="java.lang.String" />
    <field name="COL1" class="java.lang.String" />
    <field name="COL2" class="java.lang.String" />
    <field name="COL3" class="java.lang.String" />
    <field name="COL4" class="java.lang.String" />
    <field name="COL5" class="java.lang.String" />

    <group name="SectionGroup">
        <groupExpression>
            <![CDATA[$F{SECTION_NAME}]]>
        </groupExpression>
        <groupHeader>
            <band height="61">
                <printWhenExpression>
                    <![CDATA[$F{SECTION_NO}.intValue() < 89]]>
                </printWhenExpression>
                <rectangle radius="10">
                    <reportElement x="0" y="10" width="535" height="28" backcolor="#FFF3E6" />
                    <graphicElement>
                        <pen lineWidth="0" />
                    </graphicElement>
                </rectangle>
                <rectangle radius="6">
                    <reportElement x="10" y="18" width="5" height="12" backcolor="#FF6F00" />
                    <graphicElement>
                        <pen lineWidth="0" />
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="22" y="17" width="500" height="14" forecolor="#0F172A" />
                    <textElement>
                        <font fontName="Arial" size="10" isBold="true"
                            pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                            isPdfEmbedded="true" />
                    </textElement>
                    <textFieldExpression>
                        <![CDATA[$F{SECTION_NO}.intValue() == 1 ? "HIỆU QUẢ NHẬP - BÁN THEO CHI NHÁNH" : ($F{SECTION_NO}.intValue() == 2 ? "TỒN KHO THEO CHI NHÁNH" : "TOP NHÂN VIÊN THEO DOANH THU")]]>
                    </textFieldExpression>
                </textField>
                <rectangle radius="8">
                    <reportElement x="0" y="41" width="535" height="20" backcolor="#F1F5F9" />
                    <graphicElement>
                        <pen lineWidth="0" />
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="0" y="46" width="95" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="Arial" size="7.5" isBold="true"
                            pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                            isPdfEmbedded="true" />
                    </textElement>
                    <textFieldExpression>
                        <![CDATA[$F{SECTION_NO}.intValue() == 3 ? "Chi nhánh" : "Mã CN"]]>
                    </textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="95" y="46" width="140" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="Arial" size="7.5" isBold="true"
                            pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                            isPdfEmbedded="true" />
                    </textElement>
                    <textFieldExpression>
                        <![CDATA[$F{SECTION_NO}.intValue() == 3 ? "Mã NV" : "Chi nhánh"]]>
                    </textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="235" y="46" width="120" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="Arial" size="7.5" isBold="true"
                            pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                            isPdfEmbedded="true" />
                    </textElement>
                    <textFieldExpression>
                        <![CDATA[$F{SECTION_NO}.intValue() == 1 ? "Doanh thu" : ($F{SECTION_NO}.intValue() == 2 ? "Mặt hàng" : "Nhân viên")]]>
                    </textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="355" y="46" width="90" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="Arial" size="7.5" isBold="true"
                            pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                            isPdfEmbedded="true" />
                    </textElement>
                    <textFieldExpression>
                        <![CDATA[$F{SECTION_NO}.intValue() == 1 ? "Tiền nhập" : ($F{SECTION_NO}.intValue() == 2 ? "Tổng tồn" : "Số đơn")]]>
                    </textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="445" y="46" width="90" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="Arial" size="7.5" isBold="true"
                            pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                            isPdfEmbedded="true" />
                    </textElement>
                    <textFieldExpression>
                        <![CDATA[$F{SECTION_NO}.intValue() == 1 ? "Lãi gộp" : ($F{SECTION_NO}.intValue() == 2 ? "Tồn thấp" : "Doanh thu")]]>
                    </textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

