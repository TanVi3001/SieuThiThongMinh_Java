                    <textFieldExpression><![CDATA[$F{SECTION_NO}.intValue() == 1 ? "Số đơn tháng" : ($F{SECTION_NO}.intValue() == 2 ? "Mặt hàng" : "Nhân viên")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="355" y="46" width="90" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="DejaVu Sans" size="7.5" isBold="true" />
                    </textElement>
                    <textFieldExpression><![CDATA[$F{SECTION_NO}.intValue() == 1 ? "Doanh thu" : ($F{SECTION_NO}.intValue() == 2 ? "Tổng tồn" : "Số đơn")]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="445" y="46" width="90" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="DejaVu Sans" size="7.5" isBold="true" />
                    </textElement>
                    <textFieldExpression><![CDATA[$F{SECTION_NO}.intValue() == 1 ? "" : ($F{SECTION_NO}.intValue() == 2 ? "Tồn thấp" : "Doanh thu")]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

