<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="AdminSystemReport"
    pageWidth="595"
    pageHeight="842"
    columnWidth="535"
    leftMargin="30"
    rightMargin="30"
    topMargin="30"
    bottomMargin="30">

    <parameter name="P_REPORT_TITLE" class="java.lang.String" />
    <parameter name="P_REPORT_SUBTITLE" class="java.lang.String" />
    <parameter name="P_TOTAL_STORES" class="java.lang.String" />
    <parameter name="P_ACTIVE_STORES" class="java.lang.String" />
    <parameter name="P_TODAY_REVENUE" class="java.lang.String" />
    <parameter name="P_MONTH_REVENUE" class="java.lang.String" />
    <parameter name="P_TOTAL_ORDERS" class="java.lang.String" />
    <parameter name="P_LOW_STOCK" class="java.lang.String" />
    <parameter name="P_ONLINE_SESSIONS" class="java.lang.String" />
    <parameter name="P_REVENUE_ORDER_CHART" class="java.awt.Image" />
    <parameter name="P_PRODUCT_BUBBLE_CHART" class="java.awt.Image" />
    <parameter name="P_PRODUCT_PIE_3D_CHART" class="java.awt.Image" />
    <parameter name="P_REVENUE_ORDER_DIFFERENCE_CHART" class="java.awt.Image" />

    <queryString>
        <![CDATA[
            SELECT section_no,
                   section_name,
                   col1,
                   col2,
                   col3,
                   col4,
                   col5
            FROM (
                SELECT 1 AS section_no,
                       CAST('DOANH_THU_THANG_THEO_CHI_NHANH' AS VARCHAR2(100)) AS section_name,
                       CAST(s.store_id AS VARCHAR2(80)) AS col1,
                       CAST(NVL(TO_CHAR(s.store_name), TO_CHAR(s.address)) AS VARCHAR2(180)) AS col2,
                       CAST(TO_CHAR(COUNT(o.order_id)) AS VARCHAR2(80)) AS col3,
                       CAST(TO_CHAR(NVL(SUM(o.total_amount), 0), 'FM999G999G999G999') || ' VND' AS VARCHAR2(100)) AS col4,
                       CAST('' AS VARCHAR2(80)) AS col5
                FROM stores s
                LEFT JOIN orders o
                    ON o.store_id = s.store_id
                   AND NVL(o.is_deleted, 0) = 0
                   AND o.store_id IS NOT NULL
                   AND TRUNC(o.order_date, 'MM') = TRUNC(SYSDATE, 'MM')
                   AND (
                        UPPER(TO_CHAR(o.status)) = 'COMPLETED'
                        OR UPPER(TO_CHAR(o.status)) LIKE '%HOAN THANH%'
                        OR UPPER(TO_CHAR(o.status)) LIKE '%HOÀN THÀNH%'
                   )
                WHERE NVL(s.is_deleted, 0) = 0
                GROUP BY s.store_id, NVL(TO_CHAR(s.store_name), TO_CHAR(s.address))

                UNION ALL

                SELECT 2 AS section_no,
                       CAST('TON_KHO_THEO_CHI_NHANH' AS VARCHAR2(100)) AS section_name,
                       CAST(s.store_id AS VARCHAR2(80)) AS col1,
                       CAST(NVL(TO_CHAR(s.store_name), TO_CHAR(s.address)) AS VARCHAR2(180)) AS col2,
                       CAST(TO_CHAR(COUNT(DISTINCT i.product_id)) AS VARCHAR2(80)) AS col3,
                       CAST(TO_CHAR(NVL(SUM(NVL(i.quantity, 0)), 0)) AS VARCHAR2(80)) AS col4,
                       CAST(TO_CHAR(SUM(CASE WHEN NVL(i.quantity, 0) <= 20 THEN 1 ELSE 0 END)) AS VARCHAR2(80)) AS col5
                FROM stores s
                LEFT JOIN inventory i
                    ON i.store_id = s.store_id
                   AND NVL(i.is_deleted, 0) = 0
                WHERE NVL(s.is_deleted, 0) = 0
                GROUP BY s.store_id, NVL(TO_CHAR(s.store_name), TO_CHAR(s.address))

                UNION ALL

                SELECT 3 AS section_no,
                       CAST('NHAN_VIEN_CO_DOANH_THU_CAO_NHAT' AS VARCHAR2(100)) AS section_name,
                       CAST(store_name AS VARCHAR2(180)) AS col1,
                       CAST(employee_id AS VARCHAR2(80)) AS col2,
                       CAST(employee_name AS VARCHAR2(180)) AS col3,
                       CAST(TO_CHAR(total_orders) AS VARCHAR2(80)) AS col4,
                       CAST(TO_CHAR(revenue, 'FM999G999G999G999') || ' VND' AS VARCHAR2(100)) AS col5
                FROM (
                    SELECT NVL(TO_CHAR(s.store_name), e.store_id) AS store_name,
                           e.employee_id,
                           TO_CHAR(e.employee_name) AS employee_name,
                           COUNT(o.order_id) AS total_orders,
                           NVL(SUM(o.total_amount), 0) AS revenue
                    FROM employees e
                    LEFT JOIN stores s
                        ON s.store_id = e.store_id
                    LEFT JOIN orders o
                        ON o.employee_id = e.employee_id
                       AND o.store_id = e.store_id
                       AND NVL(o.is_deleted, 0) = 0
                       AND o.store_id IS NOT NULL
                       AND TRUNC(o.order_date, 'MM') = TRUNC(SYSDATE, 'MM')
                       AND (
                            UPPER(TO_CHAR(o.status)) = 'COMPLETED'
                            OR UPPER(TO_CHAR(o.status)) LIKE '%HOAN THANH%'
                            OR UPPER(TO_CHAR(o.status)) LIKE '%HOÀN THÀNH%'
                       )
                    WHERE NVL(e.is_deleted, 0) = 0
                      AND e.role_id IN ('R_STAFF_SALE', 'R_STAFF_VIEW_PROD')
                    GROUP BY NVL(TO_CHAR(s.store_name), e.store_id), e.employee_id, TO_CHAR(e.employee_name)
                    ORDER BY revenue DESC, total_orders DESC
                )
                WHERE ROWNUM = 1

                UNION ALL

                SELECT 90 AS section_no,
                       CAST('CHART_PAGE_1' AS VARCHAR2(100)) AS section_name,
                       CAST('' AS VARCHAR2(80)) AS col1,
                       CAST('' AS VARCHAR2(180)) AS col2,
                       CAST('' AS VARCHAR2(80)) AS col3,
                       CAST('' AS VARCHAR2(100)) AS col4,
                       CAST('' AS VARCHAR2(80)) AS col5
                FROM dual

                UNION ALL

                SELECT 91 AS section_no,
                       CAST('CHART_PAGE_2' AS VARCHAR2(100)) AS section_name,
                       CAST('' AS VARCHAR2(80)) AS col1,
                       CAST('' AS VARCHAR2(180)) AS col2,
                       CAST('' AS VARCHAR2(80)) AS col3,
                       CAST('' AS VARCHAR2(100)) AS col4,
                       CAST('' AS VARCHAR2(80)) AS col5
                FROM dual
            )
            ORDER BY section_no, col1, col2
        ]]>
    </queryString>

    <field name="SECTION_NO" class="java.math.BigDecimal" />
    <field name="SECTION_NAME" class="java.lang.String" />
    <field name="COL1" class="java.lang.String" />
    <field name="COL2" class="java.lang.String" />
    <field name="COL3" class="java.lang.String" />
    <field name="COL4" class="java.lang.String" />
    <field name="COL5" class="java.lang.String" />

