                    <textFieldExpression><![CDATA[$F{SECTION_NO}.intValue() == 1 ? "DOANH THU THÁNG THEO CHI NHÁNH" : ($F{SECTION_NO}.intValue() == 2 ? "TỒN KHO THEO CHI NHÁNH" : "NHÂN VIÊN CÓ DOANH THU CAO NHẤT")]]></textFieldExpression>
                </textField>

