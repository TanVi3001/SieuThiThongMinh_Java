                <graphicElement>
                    <pen lineWidth="0" />
                </graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="6" width="95" height="12" />
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="8" pdfFontName="C:/Windows/Fonts/arial.ttf"
