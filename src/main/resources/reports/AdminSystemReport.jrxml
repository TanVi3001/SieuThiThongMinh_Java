                        pdfEncoding="Identity-H" isPdfEmbedded="true" />
                </textElement>
                <textFieldExpression>
                    <![CDATA[$F{COL4}]]>
                </textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="445" y="6" width="90" height="12" />
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="8" pdfFontName="C:/Windows/Fonts/arial.ttf"
                        pdfEncoding="Identity-H" isPdfEmbedded="true" />
