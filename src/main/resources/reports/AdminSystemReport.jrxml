<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="AdminSystemReport"
        pageWidth="595"
        pageHeight="842"
        columnWidth="535"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30">

    <parameter name="P_REPORT_TITLE" class="java.lang.String"/>
    <parameter name="P_REPORT_SUBTITLE" class="java.lang.String"/>
    <parameter name="P_TOTAL_STORES" class="java.lang.String"/>
    <parameter name="P_ACTIVE_STORES" class="java.lang.String"/>
    <parameter name="P_TODAY_REVENUE" class="java.lang.String"/>
    <parameter name="P_MONTH_REVENUE" class="java.lang.String"/>
    <parameter name="P_TOTAL_ORDERS" class="java.lang.String"/>
    <parameter name="P_LOW_STOCK" class="java.lang.String"/>
    <parameter name="P_ONLINE_SESSIONS" class="java.lang.String"/>

    <queryString>
        <![CDATA[
            SELECT section_no,
                   section_name,
                   col1,
                   col2,
                   col3,
                   col4,
                   col5
            FROM (
                SELECT 1 AS section_no,
                       'DOANH THU THANG THEO CHI NHANH' AS section_name,
                       s.store_id AS col1,
                       NVL(s.store_name, s.address) AS col2,
                       TO_CHAR(COUNT(o.order_id)) AS col3,
                       TO_CHAR(NVL(SUM(o.total_amount), 0), 'FM999G999G999G999') || ' VND' AS col4,
                       '' AS col5
                FROM stores s
                LEFT JOIN orders o
                    ON o.store_id = s.store_id
                   AND NVL(o.is_deleted, 0) = 0
                   AND TRUNC(o.order_date, 'MM') = TRUNC(SYSDATE, 'MM')
                   AND (
                        UPPER(NVL(o.status, '')) = 'COMPLETED'
                        OR UPPER(NVL(o.status, '')) LIKE '%HOAN THANH%'
                        OR UPPER(NVL(o.status, '')) LIKE '%HOÀN THÀNH%'
                   )
                WHERE NVL(s.is_deleted, 0) = 0
                GROUP BY s.store_id, NVL(s.store_name, s.address)

                UNION ALL

                SELECT 2 AS section_no,
                       'TON KHO THEO CHI NHANH' AS section_name,
                       s.store_id AS col1,
                       NVL(s.store_name, s.address) AS col2,
                       TO_CHAR(COUNT(DISTINCT i.product_id)) AS col3,
                       TO_CHAR(NVL(SUM(NVL(i.quantity, 0)), 0)) AS col4,
                       TO_CHAR(SUM(CASE WHEN NVL(i.quantity, 0) <= 20 THEN 1 ELSE 0 END)) AS col5
                FROM stores s
                LEFT JOIN inventory i
                    ON i.store_id = s.store_id
                   AND NVL(i.is_deleted, 0) = 0
                WHERE NVL(s.is_deleted, 0) = 0
                GROUP BY s.store_id, NVL(s.store_name, s.address)

                UNION ALL

                SELECT 3 AS section_no,
                       'TOP NHAN VIEN THEO DOANH THU' AS section_name,
                       NVL(s.store_name, e.store_id) AS col1,
                       e.employee_id AS col2,
                       e.employee_name AS col3,
                       TO_CHAR(COUNT(o.order_id)) AS col4,
                       TO_CHAR(NVL(SUM(o.total_amount), 0), 'FM999G999G999G999') || ' VND' AS col5
                FROM employees e
                LEFT JOIN stores s
                    ON s.store_id = e.store_id
                LEFT JOIN orders o
                    ON o.employee_id = e.employee_id
                   AND o.store_id = e.store_id
                   AND NVL(o.is_deleted, 0) = 0
                   AND TRUNC(o.order_date, 'MM') = TRUNC(SYSDATE, 'MM')
                   AND (
                        UPPER(NVL(o.status, '')) = 'COMPLETED'
                        OR UPPER(NVL(o.status, '')) LIKE '%HOAN THANH%'
                        OR UPPER(NVL(o.status, '')) LIKE '%HOÀN THÀNH%'
                   )
                WHERE NVL(e.is_deleted, 0) = 0
                  AND e.role_id IN ('R_STAFF_SALE', 'R_STAFF_VIEW_PROD')
                GROUP BY NVL(s.store_name, e.store_id), e.employee_id, e.employee_name

                UNION ALL

                SELECT 4 AS section_no,
                       'CANH BAO TON KHO THAP' AS section_name,
                       NVL(s.store_name, i.store_id) AS col1,
                       i.product_id AS col2,
                       p.product_name AS col3,
                       TO_CHAR(NVL(i.quantity, 0)) AS col4,
                       '20' AS col5
                FROM inventory i
                LEFT JOIN products p
                    ON p.product_id = i.product_id
                LEFT JOIN stores s
                    ON s.store_id = i.store_id
                WHERE NVL(i.is_deleted, 0) = 0
                  AND NVL(i.quantity, 0) <= 20
            )
            ORDER BY section_no, col1, col2
        ]]>
    </queryString>

    <field name="SECTION_NO" class="java.math.BigDecimal"/>
    <field name="SECTION_NAME" class="java.lang.String"/>
    <field name="COL1" class="java.lang.String"/>
    <field name="COL2" class="java.lang.String"/>
    <field name="COL3" class="java.lang.String"/>
    <field name="COL4" class="java.lang.String"/>
    <field name="COL5" class="java.lang.String"/>

    <group name="SectionGroup">
        <groupExpression><![CDATA[$F{SECTION_NAME}]]></groupExpression>
        <groupHeader>
            <band height="34">
                <rectangle>
                    <reportElement x="0" y="8" width="535" height="22" backcolor="#FFF3E6"/>
                    <graphicElement>
                        <pen lineWidth="0"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="10" y="12" width="515" height="14" forecolor="#0F172A"/>
                    <textElement>
                        <font fontName="DejaVu Sans" size="10" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{SECTION_NAME}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="155">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="70" backcolor="#FF6F00"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="18" y="15" width="320" height="22" forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="17" isBold="true"/>
                </textElement>
                <text><![CDATA[SMART SUPERMARKET]]></text>
            </staticText>

            <textField>
                <reportElement x="18" y="38" width="320" height="16" forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{P_REPORT_SUBTITLE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="330" y="16" width="190" height="24" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{P_REPORT_TITLE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="330" y="43" width="190" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Ngày lập: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="88" width="80" height="14"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Tổng chi nhánh]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="105" width="80" height="20" forecolor="#2563EB"/>
                <textElement><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TOTAL_STORES}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="90" y="88" width="90" height="14"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Đang hoạt động]]></text>
            </staticText>
            <textField>
                <reportElement x="90" y="105" width="90" height="20" forecolor="#10B981"/>
                <textElement><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_ACTIVE_STORES}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="190" y="88" width="105" height="14"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Doanh thu hôm nay]]></text>
            </staticText>
            <textField>
                <reportElement x="190" y="105" width="105" height="20" forecolor="#F59E0B"/>
                <textElement><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TODAY_REVENUE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="305" y="88" width="105" height="14"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Doanh thu tháng]]></text>
            </staticText>
            <textField>
                <reportElement x="305" y="105" width="105" height="20" forecolor="#F59E0B"/>
                <textElement><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_MONTH_REVENUE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="420" y="88" width="115" height="14"/>
                <textElement><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement>
                <text><![CDATA[Đơn / Tồn thấp / Online]]></text>
            </staticText>
            <textField>
                <reportElement x="420" y="105" width="115" height="20" forecolor="#0F172A"/>
                <textElement><font fontName="DejaVu Sans" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TOTAL_ORDERS} + " / " + $P{P_LOW_STOCK} + " / " + $P{P_ONLINE_SESSIONS}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="22" backcolor="#F1F5F9"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText><reportElement x="0" y="5" width="95" height="12"/><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement><text><![CDATA[Thông tin 1]]></text></staticText>
            <staticText><reportElement x="95" y="5" width="140" height="12"/><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement><text><![CDATA[Thông tin 2]]></text></staticText>
            <staticText><reportElement x="235" y="5" width="120" height="12"/><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement><text><![CDATA[Thông tin 3]]></text></staticText>
            <staticText><reportElement x="355" y="5" width="90" height="12"/><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement><text><![CDATA[Thông tin 4]]></text></staticText>
            <staticText><reportElement x="445" y="5" width="90" height="12"/><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8" isBold="true"/></textElement><text><![CDATA[Thông tin 5]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="21">
            <textField><reportElement x="0" y="4" width="95" height="12"/><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{COL1}]]></textFieldExpression></textField>
            <textField><reportElement x="95" y="4" width="140" height="12"/><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{COL2}]]></textFieldExpression></textField>
            <textField><reportElement x="235" y="4" width="120" height="12"/><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{COL3}]]></textFieldExpression></textField>
            <textField><reportElement x="355" y="4" width="90" height="12"/><textElement textAlignment="Right"><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{COL4}]]></textFieldExpression></textField>
            <textField><reportElement x="445" y="4" width="90" height="12"/><textElement textAlignment="Right"><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{COL5}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#CBD5E1"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="8" width="270" height="12"/>
                <textElement><font fontName="DejaVu Sans" size="8"/></textElement>
                <text><![CDATA[Smart Supermarket - Admin System Report]]></text>
            </staticText>
            <textField>
                <reportElement x="405" y="8" width="130" height="12"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
