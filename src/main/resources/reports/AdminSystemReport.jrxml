                    <textElement textAlignment="Center">
                        <font fontName="DejaVu Sans" size="7.5" isBold="true" />
                    </textElement>
                    <textFieldExpression><![CDATA[$F{SECTION_NO}.intValue() == 3 ? "Chi nhánh" : "Mã CN"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="95" y="46" width="140" height="11" />
                    <textElement textAlignment="Center">
                        <font fontName="DejaVu Sans" size="7.5" isBold="true" />
                    </textElement>
                    <textFieldExpression><![CDATA[$F{SECTION_NO}.intValue() == 3 ? "Mã NV" : "Chi nhánh"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="235" y="46" width="120" height="11" />
