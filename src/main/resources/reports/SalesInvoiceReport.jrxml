                    <printWhenExpression><![CDATA[
$F{order_discount_amount} != null
&& $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
                </reportElement>
                <text><![CDATA[Thành tiền]]></text>
            </staticText>

            <textField pattern="#,##0">
                <reportElement style="Money" x="430" y="24" width="85" height="14">
                    <printWhenExpression><![CDATA[
$F{order_discount_amount} != null
&& $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" />
                <textFieldExpression><![CDATA[$F{order_subtotal_amount} == null ? java.math.BigDecimal.ZERO : $F{order_subtotal_amount}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="335" y="44" width="110" height="14">
                    <printWhenExpression><![CDATA[
$F{order_discount_amount} != null
&& $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
                </reportElement>
                <text><![CDATA[Giảm giá thành viên]]></text>
            </staticText>

            <textField>
                <reportElement style="Money" x="445" y="44" width="70" height="14">
                    <printWhenExpression><![CDATA[
$F{order_discount_amount} != null
&& $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" />
                <textFieldExpression><![CDATA[
$F{member_discount_amount} == null || $F{member_discount_amount}.compareTo(java.math.BigDecimal.ZERO) <= 0
? "0"
: "-" + new java.text.DecimalFormat("#,##0").format($F{member_discount_amount})
]]></textFieldExpression>
