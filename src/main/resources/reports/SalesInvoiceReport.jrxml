    <columnHeader>
        <band height="28" splitType="Stretch">
            <!-- BẢNG KHÔNG CÓ GIẢM GIÁ: ẩn % giảm và Sau giảm -->
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="245" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} == null
|| $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) <= 0
|| $F{customer_id} == null
|| $F{customer_id}.trim().isEmpty()
|| $F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
                </reportElement>
                <box leftPadding="8" />
                <textElement verticalAlignment="Middle" />
                <text><![CDATA[Sản phẩm]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="245" y="0" width="60" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} == null
|| $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) <= 0
|| $F{customer_id} == null
|| $F{customer_id}.trim().isEmpty()
|| $F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle" />
                <text><![CDATA[SL]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="305" y="0" width="105" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} == null
|| $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) <= 0
|| $F{customer_id} == null
|| $F{customer_id}.trim().isEmpty()
|| $F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle" />
                <text><![CDATA[Giá SP]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="410" y="0" width="125" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} == null
|| $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) <= 0
|| $F{customer_id} == null
|| $F{customer_id}.trim().isEmpty()
|| $F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
                </reportElement>
                <box rightPadding="8" />
                <textElement textAlignment="Right" verticalAlignment="Middle" />
                <text><![CDATA[Thành tiền]]></text>
            </staticText>

            <!-- BẢNG CÓ GIẢM GIÁ: hiện % giảm và Sau giảm -->
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="185" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} != null
&& $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
&& $F{customer_id} != null
&& !$F{customer_id}.trim().isEmpty()
&& !$F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
                </reportElement>
                <box leftPadding="8" />
                <textElement verticalAlignment="Middle" />
                <text><![CDATA[Sản phẩm]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="185" y="0" width="70" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} != null
&& $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
&& $F{customer_id} != null
&& !$F{customer_id}.trim().isEmpty()
&& !$F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle" />
                <text><![CDATA[Giá SP]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="255" y="0" width="35" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} != null
&& $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
&& $F{customer_id} != null
&& !$F{customer_id}.trim().isEmpty()
&& !$F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle" />
                <text><![CDATA[SL]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="290" y="0" width="90" height="26">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} != null
&& $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
&& $F{customer_id} != null
&& !$F{customer_id}.trim().isEmpty()
&& !$F{customer_id}.equalsIgnoreCase("GUEST")
]]></printWhenExpression>
