]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="13" isBold="true" fontName="Arial"
                        pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                        isPdfEmbedded="true" />
                </textElement>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("#,##0").format($F{total_amount} == null ? java.math.BigDecimal.ZERO : $F{total_amount}) + " VND"]]></textFieldExpression>
            </textField>

            <!-- CÓ GIẢM GIÁ: hiện rõ giảm thành viên và giảm chương trình để dễ đối soát -->
            <rectangle radius="8">
                <reportElement x="315" y="10" width="220" height="135" backcolor="#F8FAFC">
                    <printWhenExpression><![CDATA[
$F{order_discount_amount} != null
&& $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
