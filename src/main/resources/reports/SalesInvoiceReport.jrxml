            <textField pattern="#,##0.##'%'">
                <reportElement style="TableCell" x="380" y="5" width="60" height="16">
                    <printWhenExpression><![CDATA[
$F{program_discount_amount} != null
&& $F{program_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
