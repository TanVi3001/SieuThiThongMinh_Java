    <summary>
        <band height="350" splitType="Stretch">
            <staticText>
                <reportElement style="SmallMuted" x="0" y="12" width="300" height="14" />
                <text><![CDATA[Cảm ơn quý khách đã mua hàng!]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement style="SmallMuted" x="0" y="30" width="300" height="12" />
                <textFieldExpression><![CDATA["Chi nhánh: " + $F{store_name}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="SmallMuted" x="0" y="45" width="300" height="12" />
