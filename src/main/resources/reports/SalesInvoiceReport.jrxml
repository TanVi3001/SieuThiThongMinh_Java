            <staticText>
                <reportElement x="335" y="102" width="85" height="20" forecolor="#0F766E">
                    <printWhenExpression><![CDATA[
$F{order_discount_amount} != null
&& $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font size="12" isBold="true" fontName="Arial"
                        pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                        isPdfEmbedded="true" />
                </textElement>
                <text><![CDATA[TỔNG CỘNG]]></text>
            </staticText>

            <textField>
                <reportElement x="390" y="102" width="125" height="20" forecolor="#0F766E">
                    <printWhenExpression><![CDATA[
$F{order_discount_amount} != null
&& $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) > 0
]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="13" isBold="true" fontName="Arial"
                        pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                        isPdfEmbedded="true" />
                </textElement>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("#,##0").format($F{total_amount} == null ? java.math.BigDecimal.ZERO : $F{total_amount}) + " VND"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="0" y="150" width="535" height="18"
                    forecolor="#0F766E" isRemoveLineWhenBlank="true">
                    <printWhenExpression><![CDATA[$F{payment_method_code} != null && !$F{payment_method_code}.toUpperCase().contains("CASH") && ($F{payment_method_code}.toUpperCase().contains("TRANSFER") || $F{payment_method_code}.toUpperCase().contains("BANK") || $F{payment_method_code}.toUpperCase().contains("QR"))]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true" fontName="Arial"
                        pdfFontName="C:/Windows/Fonts/arial.ttf" pdfEncoding="Identity-H"
                        isPdfEmbedded="true" />
                </textElement>
                <text><![CDATA[QUÉT QR ĐỂ CHUYỂN KHOẢN]]></text>
            </staticText>

            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="197" y="172" width="140" height="140" isRemoveLineWhenBlank="true">
                    <printWhenExpression><![CDATA[$F{payment_method_code} != null && !$F{payment_method_code}.toUpperCase().contains("CASH") && ($F{payment_method_code}.toUpperCase().contains("TRANSFER") || $F{payment_method_code}.toUpperCase().contains("BANK") || $F{payment_method_code}.toUpperCase().contains("QR"))]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[
"https://img.vietqr.io/image/"
+ $P{PAYMENT_BANK_BIN}
+ "-"
+ $P{PAYMENT_ACCOUNT_NO}
+ "-compact.png?amount="
+ ($F{total_amount} == null ? "0" : $F{total_amount}.setScale(0, java.math.RoundingMode.HALF_UP).toPlainString())
+ "&addInfo=HD%20"
+ $F{order_id}
+ "&accountName=HE%20THONG%20SIEU%20THI%20THONG%20MINH"
]]></imageExpression>
            </image>

            <textField isBlankWhenNull="true">
                <reportElement style="SmallMuted" x="0" y="318" width="535" height="14"
                    isRemoveLineWhenBlank="true">
                    <printWhenExpression><![CDATA[$F{payment_method_code} != null && !$F{payment_method_code}.toUpperCase().contains("CASH") && ($F{payment_method_code}.toUpperCase().contains("TRANSFER") || $F{payment_method_code}.toUpperCase().contains("BANK") || $F{payment_method_code}.toUpperCase().contains("QR"))]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center" />
                <textFieldExpression><![CDATA["MB Bank - STK: " + $P{PAYMENT_ACCOUNT_NO}]]></textFieldExpression>
