            </textField>

            <line>
                <reportElement x="335" y="52" width="180" height="1">
                    <printWhenExpression><![CDATA[
$F{order_discount_amount} == null
|| $F{order_discount_amount}.compareTo(java.math.BigDecimal.ZERO) <= 0
]]></printWhenExpression>
                </reportElement>
