<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="SalesInvoiceReport"
    pageWidth="595"
    pageHeight="842"
    columnWidth="535"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25"
    whenNoDataType="AllSectionsNoDetail">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle" />

    <style name="Base" fontName="SansSerif" fontSize="10" forecolor="#1F2937" />
    <style name="SmallMuted" style="Base" fontSize="8" forecolor="#6B7280" />
    <style name="Label" style="Base" fontSize="9" isBold="true" forecolor="#374151" />
    <style name="SectionTitle" style="Base" fontSize="10" isBold="true" forecolor="#0F172A" />
    <style name="TableHeader" style="Base" fontSize="9" isBold="true" forecolor="#FFFFFF"
        backcolor="#0F766E" mode="Opaque" />
    <style name="TableCell" style="Base" fontSize="9" />
    <style name="Money" style="TableCell" />

    <parameter name="ORDER_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <parameter name="STORE_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <!-- QR chuyển khoản MB Bank / VietQR -->
    <parameter name="PAYMENT_ACCOUNT_NO" class="java.lang.String">
        <defaultValueExpression><![CDATA["5427350031952"]]></defaultValueExpression>
    </parameter>

    <parameter name="PAYMENT_BANK_BIN" class="java.lang.String">
        <defaultValueExpression><![CDATA["970422"]]></defaultValueExpression>
    </parameter>

    <parameter name="PAYMENT_ACCOUNT_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["HE THONG SIEU THI THONG MINH"]]></defaultValueExpression>
    </parameter>

    <!--
        Hai parameter này dùng khi Java truyền được số giảm giá tách riêng.
        Nếu không truyền, report sẽ KHÔNG tự suy đoán theo rank để tránh dồn sai:
        - MEMBER_DISCOUNT_AMOUNT mặc định 0
        - PROGRAM_DISCOUNT_AMOUNT mặc định = Thành tiền - Tổng cộng
    -->
    <parameter name="MEMBER_DISCOUNT_AMOUNT" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <parameter name="PROGRAM_DISCOUNT_AMOUNT" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
WITH order_lines AS (
    SELECT
        od.order_detail_id,
        od.order_id,
        od.product_id,
        NVL(p.product_name, TO_NCHAR(od.product_id)) AS product_name,
        NVL(od.quantity, 0) AS quantity,
        NVL(od.unit_price, 0) AS unit_price,
        NVL(NVL(od.quantity_base, od.quantity), 0) * NVL(od.unit_price, 0) AS line_total
    FROM ORDER_DETAILS od
    LEFT JOIN PRODUCTS p
        ON od.product_id = p.product_id
    WHERE NVL(od.is_deleted, 0) = 0
),
order_totals AS (
    SELECT
        order_id,
        SUM(line_total) AS order_subtotal_amount
    FROM order_lines
    GROUP BY order_id
)
SELECT
    o.order_id,
    o.order_date,
    o.store_id,

    NVL(s.store_name, TO_NCHAR(o.store_id)) AS store_name,
    NVL(s.address, N'Chưa cập nhật') AS store_address,
    NVL(TO_NCHAR(s.phone_number), N'Chưa cập nhật') AS store_phone,

    NVL(e.employee_name, TO_NCHAR(o.employee_id)) AS cashier_name,

    TO_CHAR(o.payment_method_id) AS payment_method_code,

    CASE
        WHEN o.payment_method_id IS NULL THEN N'Chưa xác định'
        WHEN UPPER(o.payment_method_id) LIKE '%CASH%' THEN N'Tiền mặt'
        WHEN UPPER(o.payment_method_id) LIKE '%TRANSFER%' THEN N'Chuyển khoản'
        WHEN UPPER(o.payment_method_id) LIKE '%BANK%' THEN N'Chuyển khoản'
        WHEN UPPER(o.payment_method_id) LIKE '%QR%' THEN N'QR/Chuyển khoản'
        ELSE TO_NCHAR(o.payment_method_id)
    END AS payment_method_name,

    NVL(c.customer_name, N'Khách vãng lai') AS customer_name,
    NVL(TO_NCHAR(o.customer_id), N'GUEST') AS customer_id,
    NVL(TO_NCHAR(c.phone), N'Chưa cập nhật') AS customer_phone,
    NVL(TO_NCHAR(c.email), N'Chưa cập nhật') AS customer_email,

    CASE
        WHEN UPPER(TO_CHAR(o.status)) = 'COMPLETED' THEN N'Đã thanh toán'
        WHEN UPPER(TO_CHAR(o.status)) = 'PENDING' THEN N'Đang xử lý'
        WHEN UPPER(TO_CHAR(o.status)) = 'CANCELLED' THEN N'Đã hủy'
        ELSE NVL(o.status, N'Chưa xác định')
    END AS status,

    NVL(o.note, N'') AS note,

    NVL(ot.order_subtotal_amount, 0) AS subtotal_amount,
    NVL(ot.order_subtotal_amount, 0) AS order_subtotal_amount,
    GREATEST(NVL(ot.order_subtotal_amount, 0) - NVL(o.total_amount, 0), 0) AS discount_amount,
    GREATEST(NVL(ot.order_subtotal_amount, 0) - NVL(o.total_amount, 0), 0) AS order_discount_amount,

/*
    Fix bug dồn giảm giá:
    - Nếu Java truyền MEMBER_DISCOUNT_AMOUNT thì dùng đúng số đó.
    - Nếu Java truyền PROGRAM_DISCOUNT_AMOUNT thì dùng đúng số đó.
    - Nếu mở lại report từ màn khác không truyền param thì fallback:
        member = subtotal - total
        program = 0
      Vì cột % giảm / Sau giảm chỉ dành cho chương trình, không được tự dồn giảm thành viên vào chương trình.
*/
    CASE
        WHEN $P{MEMBER_DISCOUNT_AMOUNT} IS NOT NULL THEN
            $P{MEMBER_DISCOUNT_AMOUNT}
        WHEN $P{PROGRAM_DISCOUNT_AMOUNT} IS NOT NULL THEN
            GREATEST(
                GREATEST(NVL(ot.order_subtotal_amount, 0) - NVL(o.total_amount, 0), 0)
                - NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0),
                0
            )
        ELSE
            GREATEST(NVL(ot.order_subtotal_amount, 0) - NVL(o.total_amount, 0), 0)
    END AS member_discount_amount,

    NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0) AS program_discount_amount,

    NVL(o.total_amount, 0) AS total_amount,

    ol.order_detail_id,
    ol.product_id,
    ol.product_name,
    ol.quantity,
    ol.unit_price,
    ol.line_total,

    /*
        Các cột % giảm / Sau giảm ở bảng chi tiết chỉ phản ánh GIẢM GIÁ CHƯƠNG TRÌNH.
        Giảm giá thành viên là giảm cấp hóa đơn, không phân bổ xuống từng dòng sản phẩm.
    */
    ROUND(
        CASE
            WHEN NVL(ot.order_subtotal_amount, 0) > 0 THEN
                (ol.line_total / ot.order_subtotal_amount)
                * NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0)
            ELSE 0
        END,
        0
    ) AS line_discount_amount,

    ROUND(
        CASE
            WHEN NVL(ol.line_total, 0) > 0 AND NVL(ot.order_subtotal_amount, 0) > 0 THEN
                (
                    (ol.line_total / ot.order_subtotal_amount)
                    * NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0)
                ) / ol.line_total * 100
            ELSE 0
        END,
        2
    ) AS line_discount_percent,

    ROUND(
        CASE
            WHEN NVL(ot.order_subtotal_amount, 0) > 0 THEN
                ol.line_total
                - (ol.line_total / ot.order_subtotal_amount)
                * NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0)
            ELSE ol.line_total
        END,
        0
    ) AS line_net_total

FROM ORDERS o

JOIN order_lines ol
    ON o.order_id = ol.order_id

LEFT JOIN order_totals ot
    ON o.order_id = ot.order_id

LEFT JOIN CUSTOMERS c
    ON o.customer_id = c.customer_id

LEFT JOIN EMPLOYEES e
    ON o.employee_id = e.employee_id

LEFT JOIN STORES s
    ON o.store_id = s.store_id

WHERE o.order_id = $P{ORDER_ID}
  AND NVL(o.is_deleted, 0) = 0
  AND (
      $P{STORE_ID} IS NULL
      OR TRIM(o.store_id) = TRIM($P{STORE_ID})
  )

ORDER BY ol.order_detail_id
        ]]>
    </queryString>

    <field name="order_id" class="java.lang.String" />
    <field name="order_date" class="java.util.Date" />
    <field name="store_id" class="java.lang.String" />
    <field name="store_name" class="java.lang.String" />
    <field name="store_address" class="java.lang.String" />
    <field name="store_phone" class="java.lang.String" />
    <field name="cashier_name" class="java.lang.String" />
    <field name="payment_method_code" class="java.lang.String" />
    <field name="payment_method_name" class="java.lang.String" />
    <field name="customer_name" class="java.lang.String" />
    <field name="customer_id" class="java.lang.String" />
    <field name="customer_phone" class="java.lang.String" />
    <field name="customer_email" class="java.lang.String" />
    <field name="status" class="java.lang.String" />
    <field name="note" class="java.lang.String" />
    <field name="discount_amount" class="java.math.BigDecimal" />
    <field name="subtotal_amount" class="java.math.BigDecimal" />
    <field name="total_amount" class="java.math.BigDecimal" />
    <field name="order_detail_id" class="java.lang.String" />
    <field name="product_id" class="java.lang.String" />
    <field name="product_name" class="java.lang.String" />
    <field name="quantity" class="java.math.BigDecimal" />
    <field name="unit_price" class="java.math.BigDecimal" />
    <field name="line_total" class="java.math.BigDecimal" />
    <field name="order_subtotal_amount" class="java.math.BigDecimal" />
    <field name="order_discount_amount" class="java.math.BigDecimal" />
    <field name="member_discount_amount" class="java.math.BigDecimal" />
    <field name="program_discount_amount" class="java.math.BigDecimal" />
    <field name="line_discount_amount" class="java.math.BigDecimal" />
    <field name="line_discount_percent" class="java.math.BigDecimal" />
    <field name="line_net_total" class="java.math.BigDecimal" />

    <variable name="LineSubtotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{line_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

