<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="SalesInvoiceReport"
    pageWidth="595"
    pageHeight="842"
    columnWidth="535"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25"
    whenNoDataType="AllSectionsNoDetail">

    <property name="net.sf.jasperreports.default.font.name" value="Arial" />
    <property name="net.sf.jasperreports.default.pdf.font.name" value="C:/Windows/Fonts/arial.ttf" />
    <property name="net.sf.jasperreports.default.pdf.encoding" value="Identity-H" />
    <property name="net.sf.jasperreports.default.pdf.embedded" value="true" />
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle" />

