<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="SalesInvoiceReport"
    pageWidth="595"
    pageHeight="842"
    columnWidth="535"
    leftMargin="30"
    rightMargin="30"
    topMargin="25"
    bottomMargin="25"
    whenNoDataType="AllSectionsNoDetail">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle" />

    <style name="Base" fontName="SansSerif" fontSize="10" forecolor="#1F2937" />
    <style name="SmallMuted" style="Base" fontSize="8" forecolor="#6B7280" />
    <style name="Label" style="Base" fontSize="9" isBold="true" forecolor="#374151" />
    <style name="SectionTitle" style="Base" fontSize="10" isBold="true" forecolor="#0F172A" />
    <style name="TableHeader" style="Base" fontSize="9" isBold="true" forecolor="#FFFFFF"
        backcolor="#0F766E" mode="Opaque" />
    <style name="TableCell" style="Base" fontSize="9" />
    <style name="Money" style="TableCell" />

    <parameter name="ORDER_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <parameter name="STORE_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
SELECT
    o.order_id,
    o.order_date,
    o.store_id,

    NVL(s.store_name, TO_NCHAR(o.store_id)) AS store_name,
    NVL(s.address, N'Chưa cập nhật') AS store_address,
    NVL(TO_NCHAR(s.phone_number), N'Chưa cập nhật') AS store_phone,

    NVL(e.employee_name, TO_NCHAR(o.employee_id)) AS cashier_name,

    CASE
        WHEN o.payment_method_id IS NULL THEN N'Chưa xác định'
        WHEN UPPER(o.payment_method_id) LIKE '%CASH%' THEN N'Tiền mặt'
        WHEN UPPER(o.payment_method_id) LIKE '%BANK%' THEN N'Chuyển khoản'
        WHEN UPPER(o.payment_method_id) LIKE '%QR%' THEN N'QR/Chuyển khoản'
        ELSE TO_NCHAR(o.payment_method_id)
    END AS payment_method_name,

    NVL(c.customer_name, N'Khách vãng lai') AS customer_name,
    NVL(TO_NCHAR(o.customer_id), N'GUEST') AS customer_id,
    NVL(TO_NCHAR(c.phone), N'Chưa cập nhật') AS customer_phone,
    NVL(TO_NCHAR(c.email), N'Chưa cập nhật') AS customer_email,

    CASE
        WHEN UPPER(TO_CHAR(o.status)) = 'COMPLETED' THEN N'Đã thanh toán'
        WHEN UPPER(TO_CHAR(o.status)) = 'PENDING' THEN N'Đang xử lý'
        WHEN UPPER(TO_CHAR(o.status)) = 'CANCELLED' THEN N'Đã hủy'
        ELSE NVL(o.status, N'Chưa xác định')
    END AS status,

    NVL(o.note, N'') AS note,

    CAST(0 AS NUMBER(15, 2)) AS discount_amount,
    NVL(o.total_amount, 0) AS subtotal_amount,
    NVL(o.total_amount, 0) AS total_amount,

    od.order_detail_id,
    od.product_id,
    NVL(p.product_name, TO_NCHAR(od.product_id)) AS product_name,
    NVL(od.quantity, 0) AS quantity,
    NVL(od.unit_price, 0) AS unit_price,
    NVL(NVL(od.quantity_base, od.quantity), 0) * NVL(od.unit_price, 0) AS line_total

FROM ORDERS o

JOIN ORDER_DETAILS od
    ON o.order_id = od.order_id
   AND NVL(od.is_deleted, 0) = 0

LEFT JOIN PRODUCTS p
    ON od.product_id = p.product_id

LEFT JOIN CUSTOMERS c
    ON o.customer_id = c.customer_id

LEFT JOIN EMPLOYEES e
    ON o.employee_id = e.employee_id

LEFT JOIN STORES s
    ON o.store_id = s.store_id

WHERE o.order_id = $P{ORDER_ID}
  AND NVL(o.is_deleted, 0) = 0
  AND (
      $P{STORE_ID} IS NULL
      OR TRIM(o.store_id) = TRIM($P{STORE_ID})
  )

ORDER BY od.order_detail_id
        ]]>
    </queryString>

    <field name="order_id" class="java.lang.String" />
    <field name="order_date" class="java.util.Date" />
    <field name="store_id" class="java.lang.String" />
    <field name="store_name" class="java.lang.String" />
    <field name="store_address" class="java.lang.String" />
    <field name="store_phone" class="java.lang.String" />
    <field name="cashier_name" class="java.lang.String" />
    <field name="payment_method_name" class="java.lang.String" />
    <field name="customer_name" class="java.lang.String" />
    <field name="customer_id" class="java.lang.String" />
    <field name="customer_phone" class="java.lang.String" />
    <field name="customer_email" class="java.lang.String" />
    <field name="status" class="java.lang.String" />
    <field name="note" class="java.lang.String" />
    <field name="discount_amount" class="java.math.BigDecimal" />
    <field name="subtotal_amount" class="java.math.BigDecimal" />
    <field name="total_amount" class="java.math.BigDecimal" />
    <field name="order_detail_id" class="java.lang.String" />
    <field name="product_id" class="java.lang.String" />
    <field name="product_name" class="java.lang.String" />
    <field name="quantity" class="java.math.BigDecimal" />
    <field name="unit_price" class="java.math.BigDecimal" />
    <field name="line_total" class="java.math.BigDecimal" />

    <variable name="LineSubtotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{line_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="250" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="82" backcolor="#0F766E" />
                <graphicElement>
                    <pen lineWidth="0.0" />
                </graphicElement>
            </rectangle>

            <rectangle radius="8">
                <reportElement x="18" y="16" width="50" height="50" backcolor="#FFFFFF" />
                <graphicElement>
                    <pen lineWidth="0.0" />
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement x="18" y="31" width="50" height="18" forecolor="#0F766E" />
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true" />
                </textElement>
                <text><![CDATA[LOGO]]></text>
            </staticText>

            <staticText>
                <reportElement x="82" y="16" width="245" height="25" forecolor="#FFFFFF" />
                <textElement>
                    <font size="17" isBold="true" />
                </textElement>
                <text><![CDATA[SMART SUPERMARKET]]></text>
            </staticText>

            <staticText>
                <reportElement x="82" y="43" width="250" height="14" forecolor="#CCFBF1" />
                <textElement>
                    <font size="9" />
                </textElement>
                <text><![CDATA[Hàng hóa tươi mới, thanh toán nhanh, dịch vụ tin cậy]]></text>
            </staticText>

            <staticText>
                <reportElement x="365" y="18" width="150" height="28" forecolor="#FFFFFF" />
                <textElement textAlignment="Right">
                    <font size="18" isBold="true" />
                </textElement>
                <text><![CDATA[HÓA ĐƠN]]></text>
            </staticText>

            <textField>
                <reportElement x="365" y="50" width="150" height="14" forecolor="#CCFBF1" />
                <textElement textAlignment="Right">
                    <font size="9" />
                </textElement>
                <textFieldExpression><![CDATA["#" + $F{order_id}]]></textFieldExpression>
            </textField>

            <rectangle radius="6">
                <reportElement x="0" y="98" width="250" height="132" backcolor="#F8FAFC" />
                <graphicElement>
                    <pen lineWidth="0.4" lineColor="#E5E7EB" />
                </graphicElement>
            </rectangle>

            <rectangle radius="6">
                <reportElement x="285" y="98" width="250" height="132" backcolor="#F8FAFC" />
                <graphicElement>
                    <pen lineWidth="0.4" lineColor="#E5E7EB" />
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement style="SectionTitle" x="14" y="109" width="160" height="14" />
                <text><![CDATA[Thông tin hóa đơn]]></text>
            </staticText>

            <staticText>
                <reportElement style="SmallMuted" x="14" y="130" width="70" height="12" />
                <text><![CDATA[Mã đơn]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="92" y="130" width="140" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{order_id}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="14" y="145" width="70" height="12" />
                <text><![CDATA[Ngày lập]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true">
                <reportElement style="Base" x="92" y="145" width="140" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{order_date}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="14" y="160" width="70" height="12" />
                <text><![CDATA[Thu ngân]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="92" y="160" width="140" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{cashier_name}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="14" y="175" width="70" height="12" />
                <text><![CDATA[Chi nhánh]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="92" y="175" width="140" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{store_name}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="14" y="190" width="70" height="12" />
                <text><![CDATA[Địa chỉ]]></text>
            </staticText>
            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement style="Base" x="92" y="190" width="140" height="20"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{store_address}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SectionTitle" x="299" y="109" width="180" height="14" />
                <text><![CDATA[Thông tin khách hàng]]></text>
            </staticText>

            <staticText>
                <reportElement style="SmallMuted" x="299" y="130" width="74" height="12" />
                <text><![CDATA[Khách hàng]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="382" y="130" width="135" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{customer_name}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="299" y="145" width="74" height="12" />
                <text><![CDATA[Mã khách]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="382" y="145" width="135" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{customer_id}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="299" y="160" width="74" height="12" />
                <text><![CDATA[Thanh toán]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="382" y="160" width="135" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{payment_method_name}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="299" y="175" width="74" height="12" />
                <text><![CDATA[Trạng thái]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="382" y="175" width="135" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="299" y="190" width="74" height="12" />
                <text><![CDATA[Mã CH]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="382" y="190" width="135" height="12"
                    forecolor="#111827" />
                <textElement textAlignment="Right">
                    <font size="8" />
                </textElement>
                <textFieldExpression><![CDATA[$F{store_id}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28" splitType="Stretch">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="245" height="26" />
                <box leftPadding="8" />
                <textElement verticalAlignment="Middle" />
                <text><![CDATA[Sản phẩm]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="245" y="0" width="60" height="26" />
                <textElement textAlignment="Center" verticalAlignment="Middle" />
                <text><![CDATA[SL]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="305" y="0" width="105" height="26" />
                <textElement textAlignment="Right" verticalAlignment="Middle" />
                <text><![CDATA[Đơn giá]]></text>
            </staticText>

            <staticText>
                <reportElement style="TableHeader" x="410" y="0" width="125" height="26" />
                <box rightPadding="8" />
                <textElement textAlignment="Right" verticalAlignment="Middle" />
                <text><![CDATA[Thành tiền]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="26" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="26" backcolor="#FFFFFF" />
                <graphicElement>
                    <pen lineWidth="0.25" lineColor="#E5E7EB" />
                </graphicElement>
            </rectangle>

            <textField isBlankWhenNull="true" textAdjust="StretchHeight">
                <reportElement style="TableCell" x="0" y="5" width="245" height="16" />
                <box leftPadding="8" />
                <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0">
                <reportElement style="TableCell" x="245" y="5" width="60" height="16" />
                <textElement textAlignment="Center" />
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0">
                <reportElement style="Money" x="305" y="5" width="105" height="16" />
                <textElement textAlignment="Right" />
                <textFieldExpression><![CDATA[$F{unit_price}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0">
                <reportElement style="Money" x="410" y="5" width="125" height="16" />
                <box rightPadding="8" />
                <textElement textAlignment="Right" />
                <textFieldExpression><![CDATA[$F{line_total}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="25" splitType="Stretch">
            <line>
                <reportElement x="0" y="0" width="535" height="1" />
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#E5E7EB" />
                </graphicElement>
            </line>

            <staticText>
                <reportElement style="SmallMuted" x="0" y="8" width="280" height="12" />
                <text><![CDATA[Smart Supermarket - Tạo bởi JasperReports]]></text>
            </staticText>

            <textField>
                <reportElement style="SmallMuted" x="455" y="8" width="80" height="12" />
                <textElement textAlignment="Right" />
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="150" splitType="Stretch">
            <staticText>
                <reportElement style="SmallMuted" x="0" y="12" width="300" height="14" />
                <text><![CDATA[Cảm ơn quý khách đã mua hàng!]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement style="SmallMuted" x="0" y="30" width="300" height="12" />
                <textFieldExpression><![CDATA["Chi nhánh: " + $F{store_name}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="SmallMuted" x="0" y="45" width="300" height="12" />
                <textFieldExpression><![CDATA["Địa chỉ: " + $F{store_address}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement style="SmallMuted" x="0" y="62" width="300" height="34" />
                <textFieldExpression><![CDATA[$F{note} == null || $F{note}.trim().isEmpty() ? "" : "Ghi chú: " + $F{note}]]></textFieldExpression>
            </textField>

            <rectangle radius="8">
                <reportElement x="315" y="10" width="220" height="115" backcolor="#F8FAFC" />
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#CBD5E1" />
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement style="Label" x="335" y="26" width="80" height="14" />
                <text><![CDATA[Thành tiền]]></text>
            </staticText>

            <textField pattern="#,##0">
                <reportElement style="Money" x="425" y="26" width="90" height="14" />
                <textElement textAlignment="Right" />
                <textFieldExpression><![CDATA[$V{LineSubtotal} == null ? java.math.BigDecimal.ZERO : $V{LineSubtotal}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="Label" x="335" y="48" width="80" height="14" />
                <text><![CDATA[Giảm giá]]></text>
            </staticText>

            <textField pattern="#,##0">
                <reportElement style="Money" x="425" y="48" width="90" height="14" />
                <textElement textAlignment="Right" />
                <textFieldExpression><![CDATA[$F{discount_amount} == null ? java.math.BigDecimal.ZERO : $F{discount_amount}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="335" y="70" width="180" height="1" />
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#CBD5E1" />
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="335" y="82" width="85" height="20" forecolor="#0F766E" />
                <textElement verticalAlignment="Middle">
                    <font size="12" isBold="true" />
                </textElement>
                <text><![CDATA[TỔNG CỘNG]]></text>
            </staticText>

            <textField pattern="#,##0">
                <reportElement x="420" y="82" width="95" height="20" forecolor="#0F766E" />
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="13" isBold="true" />
                </textElement>
                <textFieldExpression><![CDATA[$F{total_amount} == null ? java.math.BigDecimal.ZERO : $F{total_amount}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement style="SmallMuted" x="452" y="106" width="63" height="10" />
                <textElement textAlignment="Right" />
                <text><![CDATA[VND]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>