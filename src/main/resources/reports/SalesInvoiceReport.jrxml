    <style name="Money" style="TableCell" />

    <parameter name="ORDER_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="STORE_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
SELECT
    o.order_id,
    o.order_date,
    o.store_id,
    NVL(s.store_name, o.store_id) AS store_name,
    NVL(e.employee_name, o.employee_id) AS cashier_name,
    NVL(o.payment_method_id, 'N/A') AS payment_method_name,
    NVL(c.customer_name, 'Khách vãng lai') AS customer_name,
    NVL(o.customer_id, 'N/A') AS customer_id,
    o.status,
    o.note,
    CAST(0 AS NUMBER(15, 2)) AS discount_amount,
    NVL(o.total_amount, 0) AS subtotal_amount,
    NVL(o.total_amount, 0) AS total_amount,
    od.order_detail_id,
    od.product_id,
    NVL(p.product_name, od.product_id) AS product_name,
    NVL(od.quantity, 0) AS quantity,
    NVL(od.unit_price, 0) AS unit_price,
    NVL(NVL(od.quantity_base, od.quantity), 0) * NVL(od.unit_price, 0) AS line_total
FROM ORDERS o
JOIN ORDER_DETAILS od
    ON o.order_id = od.order_id
   AND NVL(od.is_deleted, 0) = 0
LEFT JOIN PRODUCTS p
    ON od.product_id = p.product_id
LEFT JOIN CUSTOMERS c
    ON o.customer_id = c.customer_id
LEFT JOIN EMPLOYEES e
    ON o.employee_id = e.employee_id
LEFT JOIN STORES s
    ON o.store_id = s.store_id
WHERE o.order_id = $P{ORDER_ID}
  AND NVL(o.is_deleted, 0) = 0
  AND (
      $P{STORE_ID} IS NULL
      OR TRIM(o.store_id) = TRIM($P{STORE_ID})
  )
ORDER BY od.order_detail_id
        ]]>
    </queryString>

    <field name="order_id" class="java.lang.String" />
    <field name="order_date" class="java.util.Date" />
    <field name="store_id" class="java.lang.String" />
    <field name="store_name" class="java.lang.String" />
    <field name="cashier_name" class="java.lang.String" />
    <field name="payment_method_name" class="java.lang.String" />
    <field name="customer_name" class="java.lang.String" />
    <field name="customer_id" class="java.lang.String" />
    <field name="status" class="java.lang.String" />
    <field name="note" class="java.lang.String" />
    <field name="discount_amount" class="java.math.BigDecimal" />
    <field name="subtotal_amount" class="java.math.BigDecimal" />
    <field name="total_amount" class="java.math.BigDecimal" />
    <field name="order_detail_id" class="java.lang.String" />
    <field name="product_id" class="java.lang.String" />
    <field name="product_name" class="java.lang.String" />
    <field name="quantity" class="java.math.BigDecimal" />
    <field name="unit_price" class="java.math.BigDecimal" />
    <field name="line_total" class="java.math.BigDecimal" />

    <variable name="ItemCount" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{order_detail_id}]]></variableExpression>
    </variable>

    <variable name="LineSubtotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{line_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

