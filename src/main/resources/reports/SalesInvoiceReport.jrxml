        isPdfEmbedded="true" />

    <parameter name="ORDER_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <parameter name="STORE_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <!-- QR chuyển khoản MB Bank / VietQR -->
    <parameter name="PAYMENT_ACCOUNT_NO" class="java.lang.String">
        <defaultValueExpression><![CDATA["5427350031952"]]></defaultValueExpression>
    </parameter>

    <parameter name="PAYMENT_BANK_BIN" class="java.lang.String">
        <defaultValueExpression><![CDATA["970422"]]></defaultValueExpression>
    </parameter>

    <parameter name="PAYMENT_ACCOUNT_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["HE THONG SIEU THI THONG MINH"]]></defaultValueExpression>
    </parameter>

    <!--
        Hai parameter này dùng khi Java truyền được số giảm giá tách riêng.
        Nếu không truyền, report sẽ KHÔNG tự suy đoán theo rank để tránh dồn sai:
        - MEMBER_DISCOUNT_AMOUNT mặc định 0
        - PROGRAM_DISCOUNT_AMOUNT mặc định = Thành tiền - Tổng cộng
    -->
    <parameter name="MEMBER_DISCOUNT_AMOUNT" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <parameter name="PROGRAM_DISCOUNT_AMOUNT" class="java.math.BigDecimal">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
WITH order_lines AS (
    SELECT
        od.order_detail_id,
        od.order_id,
        od.product_id,
        NVL(TO_CHAR(p.product_name), TO_CHAR(od.product_id)) AS product_name,
        NVL(TO_CHAR(u.unit_name), NVL(TO_CHAR(od.unit_id), N'Đơn vị')) AS unit_name,
        NVL(od.quantity, 0) AS quantity,
        NVL(od.unit_price, 0) AS unit_price,

        -- unit_price là giá theo đơn vị bán đã chọn.
        -- quantity là số lượng theo đơn vị bán.
        -- quantity_base chỉ dùng để trừ kho, không dùng để tính tiền hóa đơn.
        NVL(od.quantity, 0) * NVL(od.unit_price, 0) AS line_total,

        NVL(od.program_discount_percent, 0) AS line_discount_percent,
        NVL(od.program_discount_amount, 0) AS line_discount_amount,
        NVL(
            od.line_net_total,
            NVL(od.quantity, 0) * NVL(od.unit_price, 0)
            - NVL(od.program_discount_amount, 0)
        ) AS line_net_total
    FROM ORDER_DETAILS od
    LEFT JOIN PRODUCTS p
        ON od.product_id = p.product_id
    LEFT JOIN UNITS u
        ON od.unit_id = u.unit_id
       AND NVL(u.is_deleted, 0) = 0
    WHERE NVL(od.is_deleted, 0) = 0
),
order_totals AS (
    SELECT
        order_id,
        SUM(line_total) AS order_subtotal_amount
    FROM order_lines
    GROUP BY order_id
)
SELECT
    o.order_id,
    o.order_date,
    o.store_id,

    NVL(TO_CHAR(s.store_name), TO_CHAR(o.store_id)) AS store_name,
    NVL(TO_CHAR(s.address), 'Chưa cập nhật') AS store_address,
    NVL(TO_CHAR(s.phone_number), 'Chưa cập nhật') AS store_phone,

    NVL(TO_CHAR(e.employee_name), TO_CHAR(o.employee_id)) AS cashier_name,

    TO_CHAR(o.payment_method_id) AS payment_method_code,

    CASE
        WHEN o.payment_method_id IS NULL THEN 'Chưa xác định'
        WHEN UPPER(o.payment_method_id) LIKE '%CASH%' THEN 'Tiền mặt'
        WHEN UPPER(o.payment_method_id) LIKE '%TRANSFER%' THEN 'Chuyển khoản'
        WHEN UPPER(o.payment_method_id) LIKE '%BANK%' THEN 'Chuyển khoản'
        WHEN UPPER(o.payment_method_id) LIKE '%QR%' THEN 'QR/Chuyển khoản'
        ELSE TO_CHAR(o.payment_method_id)
    END AS payment_method_name,

    NVL(TO_CHAR(c.customer_name), 'Khách vãng lai') AS customer_name,
    NVL(TO_CHAR(o.customer_id), 'GUEST') AS customer_id,
    NVL(TO_CHAR(c.phone), 'Chưa cập nhật') AS customer_phone,
    NVL(TO_CHAR(c.email), 'Chưa cập nhật') AS customer_email,

    CASE
        WHEN UPPER(TO_CHAR(o.status)) = 'COMPLETED' THEN 'Đã thanh toán'
        WHEN UPPER(TO_CHAR(o.status)) = 'PENDING' THEN 'Đang xử lý'
        WHEN UPPER(TO_CHAR(o.status)) = 'CANCELLED' THEN 'Đã hủy'
        ELSE NVL(TO_CHAR(o.status), 'Chưa xác định')
    END AS status,

    NVL(TO_CHAR(o.note), '') AS note,

    NVL(ot.order_subtotal_amount, 0) AS subtotal_amount,
    NVL(ot.order_subtotal_amount, 0) AS order_subtotal_amount,

    NVL(o.member_discount_amount, NVL($P{MEMBER_DISCOUNT_AMOUNT}, 0)) AS member_discount_amount,
    NVL(o.program_discount_amount, NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0)) AS program_discount_amount,

    NVL(o.member_discount_amount, NVL($P{MEMBER_DISCOUNT_AMOUNT}, 0))
    + NVL(o.program_discount_amount, NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0)) AS discount_amount,

    NVL(o.member_discount_amount, NVL($P{MEMBER_DISCOUNT_AMOUNT}, 0))
    + NVL(o.program_discount_amount, NVL($P{PROGRAM_DISCOUNT_AMOUNT}, 0)) AS order_discount_amount,

    NVL(o.total_amount, 0) AS total_amount,

    ol.order_detail_id,
    ol.product_id,
    ol.product_name,
    ol.unit_name,
    ol.quantity,
    ol.unit_price,
    ol.line_total,
    ol.line_discount_amount,
    ol.line_discount_percent,
    ol.line_net_total

FROM ORDERS o

JOIN order_lines ol
    ON o.order_id = ol.order_id

LEFT JOIN order_totals ot
    ON o.order_id = ot.order_id

LEFT JOIN CUSTOMERS c
    ON o.customer_id = c.customer_id

LEFT JOIN EMPLOYEES e
    ON o.employee_id = e.employee_id

LEFT JOIN STORES s
    ON o.store_id = s.store_id

WHERE o.order_id = $P{ORDER_ID}
  AND NVL(o.is_deleted, 0) = 0
  AND (
      $P{STORE_ID} IS NULL
      OR TRIM(o.store_id) = TRIM($P{STORE_ID})
  )

ORDER BY ol.order_detail_id
        ]]>
    </queryString>

    <field name="order_id" class="java.lang.String" />
    <field name="order_date" class="java.util.Date" />
    <field name="store_id" class="java.lang.String" />
    <field name="store_name" class="java.lang.String" />
    <field name="store_address" class="java.lang.String" />
    <field name="store_phone" class="java.lang.String" />
    <field name="cashier_name" class="java.lang.String" />
    <field name="payment_method_code" class="java.lang.String" />
    <field name="payment_method_name" class="java.lang.String" />
    <field name="customer_name" class="java.lang.String" />
    <field name="customer_id" class="java.lang.String" />
    <field name="customer_phone" class="java.lang.String" />
    <field name="customer_email" class="java.lang.String" />
    <field name="status" class="java.lang.String" />
    <field name="note" class="java.lang.String" />
    <field name="discount_amount" class="java.math.BigDecimal" />
    <field name="subtotal_amount" class="java.math.BigDecimal" />
    <field name="total_amount" class="java.math.BigDecimal" />
    <field name="order_detail_id" class="java.lang.String" />
    <field name="product_id" class="java.lang.String" />
    <field name="product_name" class="java.lang.String" />
    <field name="unit_name" class="java.lang.String" />
    <field name="quantity" class="java.math.BigDecimal" />
    <field name="unit_price" class="java.math.BigDecimal" />
    <field name="line_total" class="java.math.BigDecimal" />
    <field name="order_subtotal_amount" class="java.math.BigDecimal" />
    <field name="order_discount_amount" class="java.math.BigDecimal" />
    <field name="member_discount_amount" class="java.math.BigDecimal" />
    <field name="program_discount_amount" class="java.math.BigDecimal" />
    <field name="line_discount_amount" class="java.math.BigDecimal" />
    <field name="line_discount_percent" class="java.math.BigDecimal" />
    <field name="line_net_total" class="java.math.BigDecimal" />

    <variable name="LineSubtotal" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{line_total}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

