<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="PurchaseReceiptReport"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="802"
    leftMargin="20"
    rightMargin="20"
    topMargin="16"
    bottomMargin="16">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle" />

    <style name="Base" fontName="SansSerif" fontSize="9" forecolor="#111827" />
    <style name="Muted" style="Base" fontSize="8" forecolor="#64748B" />
    <style name="Label" style="Base" fontSize="9" isBold="true" forecolor="#0F766E" />
    <style name="CardLabel" style="Base" fontSize="8" forecolor="#64748B" />
    <style name="TableHeader" style="Base" fontSize="8" isBold="true" forecolor="#FFFFFF"
        backcolor="#0F766E" mode="Opaque" />
    <style name="TableCell" style="Base" fontSize="8" />
    <style name="Money" style="TableCell" hTextAlign="Right" />

    <parameter name="RECEIPT_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="AMOUNT_IN_WORDS" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
SELECT
    ROW_NUMBER() OVER (ORDER BY d.created_at, d.receipt_detail_id) AS no,
    r.receipt_id,
    r.created_at AS receipt_date,
    NVL(s.supplier_name, r.supplier_id) AS supplier_name,
    NVL(s.supplier_name, 'Nhà cung cấp') AS delivery_person,
    NVL(s.phone_number, '') AS supplier_phone,
    NVL(s.address, '') AS supplier_address,
    NVL(st.store_name, NVL('Kho ' || r.store_id, 'Kho Tổng')) AS warehouse_name,
    NVL(e.employee_name, NVL(u.full_name, r.created_by)) AS employee_name,
    'Chưa ghi nhận' AS payment_method,
    NVL(st.address, NVL(s.address, '')) AS warehouse_address,
    NVL(r.note, '') AS note,
    NVL(r.total_before_tax, 0) AS subtotal,
    NVL(r.total_tax, 0) AS vat_total,
    NVL(r.total_after_tax, 0) AS grand_total,
    d.product_id AS product_code,
    NVL(p.product_name, d.product_id) AS product_name,
    NVL(d.quantity, 0) AS quantity,
    NVL(d.unit, 'Cái') AS unit,
    NVL(d.unit_import_price, 0) AS import_price,
    NVL(d.vat_rate, 0) AS vat_percent,
    ROUND(NVL(d.unit_import_price, 0) * (1 + NVL(d.vat_rate, 0) / 100), 2) AS import_price_with_vat,
    NVL(d.sale_price, 0) AS selling_price,
    NVL(d.line_after_tax, 0) AS line_total
FROM PURCHASE_RECEIPTS r
JOIN PURCHASE_RECEIPT_DETAILS d
    ON d.receipt_id = r.receipt_id
    AND NVL(d.is_deleted, 0) = 0
LEFT JOIN SUPPLIERS s
    ON s.supplier_id = r.supplier_id
LEFT JOIN PRODUCTS p
    ON p.product_id = d.product_id
LEFT JOIN ACCOUNTS a
    ON a.account_id = r.created_by
LEFT JOIN USERS u
    ON u.user_id = a.user_id
LEFT JOIN EMPLOYEES e
    ON e.employee_id = a.user_id
LEFT JOIN (
    SELECT receipt_id, MIN(store_id) AS store_id
    FROM INVENTORY_TRANSACTIONS
    WHERE NVL(is_deleted, 0) = 0
    GROUP BY receipt_id
) tx
    ON tx.receipt_id = r.receipt_id
LEFT JOIN STORES st
    ON st.store_id = NVL(r.store_id, tx.store_id)
WHERE r.receipt_id = $P{RECEIPT_ID}
  AND NVL(r.is_deleted, 0) = 0
ORDER BY d.created_at, d.receipt_detail_id
        ]]>
    </queryString>

    <field name="no" class="java.math.BigDecimal" />
    <field name="receipt_id" class="java.lang.String" />
    <field name="receipt_date" class="java.util.Date" />
    <field name="supplier_name" class="java.lang.String" />
    <field name="delivery_person" class="java.lang.String" />
    <field name="supplier_phone" class="java.lang.String" />
    <field name="supplier_address" class="java.lang.String" />
    <field name="warehouse_name" class="java.lang.String" />
    <field name="employee_name" class="java.lang.String" />
    <field name="payment_method" class="java.lang.String" />
    <field name="warehouse_address" class="java.lang.String" />
    <field name="note" class="java.lang.String" />
    <field name="subtotal" class="java.math.BigDecimal" />
    <field name="vat_total" class="java.math.BigDecimal" />
    <field name="grand_total" class="java.math.BigDecimal" />
    <field name="product_code" class="java.lang.String" />
    <field name="product_name" class="java.lang.String" />
    <field name="quantity" class="java.math.BigDecimal" />
    <field name="unit" class="java.lang.String" />
    <field name="import_price" class="java.math.BigDecimal" />
    <field name="vat_percent" class="java.math.BigDecimal" />
    <field name="import_price_with_vat" class="java.math.BigDecimal" />
    <field name="selling_price" class="java.math.BigDecimal" />
    <field name="line_total" class="java.math.BigDecimal" />

