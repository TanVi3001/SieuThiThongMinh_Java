    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="RevenueReport"
    pageWidth="842"
    pageHeight="595"
    orientation="Landscape"
    columnWidth="782"
    leftMargin="30"
    rightMargin="30"
    topMargin="24"
    bottomMargin="24"
    whenNoDataType="AllSectionsNoDetail"
    uuid="d73ac4a2-6511-4d2e-85c8-0fc2dd9efc31">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="Oracle" />

    <style name="Base" fontName="SansSerif" fontSize="10" forecolor="#1F2937" />
    <style name="SmallMuted" style="Base" fontSize="8" forecolor="#6B7280" />
    <style name="Label" style="Base" fontSize="9" isBold="true" forecolor="#374151" />
    <style name="TableHeader" style="Base" fontSize="9" isBold="true" forecolor="#FFFFFF"
        backcolor="#0F766E" mode="Opaque" />
    <style name="TableCell" style="Base" fontSize="9" />
    <style name="Money" style="TableCell" hTextAlign="Right" />

    <parameter name="START_DATE" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <parameter name="END_DATE" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <parameter name="END_DATE_PLUS_ONE" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date(System.currentTimeMillis() + 86400000L)]]></defaultValueExpression>
    </parameter>
    <parameter name="REPORT_TYPE" class="java.lang.String">
        <defaultValueExpression><![CDATA["DAY"]]></defaultValueExpression>
    </parameter>
    <parameter name="REPORT_TYPE_LABEL" class="java.lang.String">
        <defaultValueExpression><![CDATA["Theo ngày"]]></defaultValueExpression>
    </parameter>
    <parameter name="PERIOD_HEADER" class="java.lang.String">
        <defaultValueExpression><![CDATA["Kỳ báo cáo"]]></defaultValueExpression>
    </parameter>
    <parameter name="STORE_ID" class="java.lang.String">
        <defaultValueExpression><![CDATA[null]]></defaultValueExpression>
    </parameter>
    <parameter name="STORE_NAME" class="java.lang.String">
        <defaultValueExpression><![CDATA["Toàn hệ thống"]]></defaultValueExpression>
    </parameter>
    <parameter name="IS_ADMIN_REPORT" class="java.lang.Boolean">
        <defaultValueExpression><![CDATA[java.lang.Boolean.FALSE]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
    <![CDATA[
WITH report_params AS (
    SELECT
        $P{REPORT_TYPE} AS report_type,
        TRUNC($P{START_DATE}) AS start_period
    FROM dual
),
valid_orders AS (
    SELECT
        o.order_id,
        o.order_date,
        o.store_id,
        NVL(o.total_amount, 0) AS total_amount
    FROM orders o
    WHERE NVL(o.is_deleted, 0) = 0
      AND (
          UPPER(NVL(o.status, '')) = 'COMPLETED'
          OR UPPER(NVL(o.status, '')) LIKE '%HOÀN THÀNH%'
          OR UPPER(NVL(o.status, '')) LIKE '%HOAN THANH%'
      )
      AND o.order_date >= $P{START_DATE}
      AND o.order_date < $P{END_DATE_PLUS_ONE}
      AND (
          $P{STORE_ID} IS NULL
          OR TRIM(o.store_id) = TRIM($P{STORE_ID})
      )
),
detail_totals AS (
    SELECT
        od.order_id,
        SUM(NVL(od.quantity_base, od.quantity)) AS products_sold
    FROM order_details od
    WHERE NVL(od.is_deleted, 0) = 0
    GROUP BY od.order_id
),
order_periods AS (
    SELECT
        CASE
            WHEN rp.report_type = 'DAY' THEN TRUNC(vo.order_date)
            WHEN rp.report_type = 'MONTH' THEN TRUNC(vo.order_date, 'MM')
            WHEN rp.report_type = 'YEAR' THEN TRUNC(vo.order_date, 'YYYY')
            ELSE rp.start_period
        END AS period_start,
        CASE
            WHEN rp.report_type = 'DAY' THEN TO_CHAR(TRUNC(vo.order_date), 'DD/MM/YYYY')
            WHEN rp.report_type = 'MONTH' THEN TO_CHAR(TRUNC(vo.order_date, 'MM'), 'MM/YYYY')
            WHEN rp.report_type = 'YEAR' THEN TO_CHAR(TRUNC(vo.order_date, 'YYYY'), 'YYYY')
            ELSE 'Toàn kỳ'
        END AS period_label,
        vo.order_id,
        vo.total_amount,
        NVL(dt.products_sold, 0) AS products_sold
    FROM valid_orders vo
    CROSS JOIN report_params rp
    LEFT JOIN detail_totals dt
        ON vo.order_id = dt.order_id
),
grouped_revenue AS (
    SELECT
        period_start,
        period_label,
        COUNT(*) AS orders_count,
        SUM(products_sold) AS products_sold,
        SUM(total_amount) AS revenue
    FROM order_periods
    GROUP BY
        period_start,
        period_label
),
import_periods AS (
    SELECT
        CASE
            WHEN rp.report_type = 'DAY' THEN TRUNC(pr.created_at)
            WHEN rp.report_type = 'MONTH' THEN TRUNC(pr.created_at, 'MM')
            WHEN rp.report_type = 'YEAR' THEN TRUNC(pr.created_at, 'YYYY')
            ELSE rp.start_period
        END AS period_start,
        CASE
            WHEN rp.report_type = 'DAY' THEN TO_CHAR(TRUNC(pr.created_at), 'DD/MM/YYYY')
            WHEN rp.report_type = 'MONTH' THEN TO_CHAR(TRUNC(pr.created_at, 'MM'), 'MM/YYYY')
            WHEN rp.report_type = 'YEAR' THEN TO_CHAR(TRUNC(pr.created_at, 'YYYY'), 'YYYY')
            ELSE 'Toàn kỳ'
        END AS period_label,
        NVL(pr.total_after_tax, 0) AS import_cost
    FROM purchase_receipts pr
    CROSS JOIN report_params rp
    WHERE NVL(pr.is_deleted, 0) = 0
      AND pr.created_at >= $P{START_DATE}
      AND pr.created_at < $P{END_DATE_PLUS_ONE}
      AND (
          $P{STORE_ID} IS NULL
          OR TRIM(pr.store_id) = TRIM($P{STORE_ID})
      )
),
grouped_import AS (
    SELECT
        period_start,
        period_label,
        SUM(import_cost) AS import_cost
    FROM import_periods
    GROUP BY
        period_start,
        period_label
),
combined AS (
    SELECT
        NVL(gr.period_start, gi.period_start) AS period_start,
        NVL(gr.period_label, gi.period_label) AS period_label,
        NVL(gr.orders_count, 0) AS orders_count,
        NVL(gr.products_sold, 0) AS products_sold,
        NVL(gr.revenue, 0) AS revenue,
        NVL(gi.import_cost, 0) AS import_cost,
        NVL(gr.revenue, 0) - NVL(gi.import_cost, 0) AS gross_profit,
        CASE
            WHEN NVL(gr.revenue, 0) = 0 THEN 0
            ELSE ROUND((NVL(gr.revenue, 0) - NVL(gi.import_cost, 0)) / NVL(gr.revenue, 0) * 100, 2)
        END AS gross_profit_margin
    FROM grouped_revenue gr
    FULL OUTER JOIN grouped_import gi
        ON gr.period_start = gi.period_start
)
SELECT
    period_start,
    period_label,
    orders_count,
    products_sold,
    revenue,
    import_cost,
    gross_profit,
    gross_profit_margin,
    SUM(revenue) OVER () AS total_revenue,
    SUM(orders_count) OVER () AS total_orders,
    SUM(products_sold) OVER () AS total_products_sold,
    SUM(import_cost) OVER () AS total_import_cost,
    SUM(gross_profit) OVER () AS total_gross_profit,
    CASE
        WHEN SUM(revenue) OVER () = 0 THEN 0
        ELSE ROUND(SUM(gross_profit) OVER () / SUM(revenue) OVER () * 100, 2)
    END AS total_gross_profit_margin,
    CASE
        WHEN SUM(orders_count) OVER () = 0 THEN 0
        ELSE SUM(revenue) OVER () / SUM(orders_count) OVER ()
    END AS avg_order_value
FROM combined
ORDER BY period_start
    ]]>
    </queryString>

    <field name="period_start" class="java.util.Date" />
    <field name="period_label" class="java.lang.String" />
    <field name="orders_count" class="java.math.BigDecimal" />
    <field name="products_sold" class="java.math.BigDecimal" />
    <field name="revenue" class="java.math.BigDecimal" />
    <field name="import_cost" class="java.math.BigDecimal" />
    <field name="gross_profit" class="java.math.BigDecimal" />
    <field name="gross_profit_margin" class="java.math.BigDecimal" />
    <field name="total_revenue" class="java.math.BigDecimal" />
    <field name="total_orders" class="java.math.BigDecimal" />
    <field name="total_products_sold" class="java.math.BigDecimal" />
    <field name="total_import_cost" class="java.math.BigDecimal" />
    <field name="total_gross_profit" class="java.math.BigDecimal" />
    <field name="total_gross_profit_margin" class="java.math.BigDecimal" />
    <field name="avg_order_value" class="java.math.BigDecimal" />

    <variable name="TotalOrders" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{orders_count}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TotalProductsSold" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{products_sold}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TotalRevenue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{revenue}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TotalImportCost" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{import_cost}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="TotalGrossProfit" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{gross_profit}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

